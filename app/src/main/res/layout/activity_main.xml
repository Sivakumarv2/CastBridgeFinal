<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/castbridge_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CastBridge"
            android:textColor="@color/castbridge_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Not connected"
            android:textColor="@color/castbridge_text"
            android:textSize="16sp" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/castButton"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:contentDescription="Cast to TV"
            android:mediaRouteTypes="user" />

        <Button
            android:id="@+id/browserButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:text="🌐  Open Web Browser"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Browse a website inside CastBridge. Use the Cast button to connect your TV, then use Cast Video when a page exposes a direct HTML5 video URL."
            android:textColor="@color/castbridge_text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Paste a direct video/audio URL"
            android:inputType="textUri"
            android:minHeight="56dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Play direct URL on TV"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Stop casting"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Important: Chromecast-enabled apps can continue to use their own Cast button. DRM-protected streams and services that do not expose a castable/direct media stream cannot be bypassed. Screen mirroring is not used."
            android:textColor="@color/castbridge_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/castbridge_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="28sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/forwardButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:text="›"
            android:textSize="28sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Enter website address"
            android:inputType="textUri"
            android:singleLine="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/goButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="Go"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:padding="0dp" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/browserCastButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Cast to TV"
            android:mediaRouteTypes="user" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/browserConnectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Not connected"
            android:textColor="@color/castbridge_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/reloadButton"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:text="Reload"
            android:textAllCaps="false"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/castVideoButton"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="Cast Video"
            android:textAllCaps="false"
            android:minWidth="0dp" />
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
